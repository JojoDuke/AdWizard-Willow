# Copy to .env and fill in. Never commit .env.
# Default model in code: openrouter/openai/gpt-5.6-sol
OPENROUTER_API_KEY=

# Production (Render/Railway) sets this. Local mastra start defaults to 4111.
# Villow local server defaults to 8080.
# PORT=4111

# Public origin used to build imageUrl on staged artifacts.
PUBLIC_BASE_URL=https://adwizard-willow.onrender.com

# From Villow onboarding (not in this repo). See GETTING_STARTED.md.
VILLOW_PUBLISHER_ID=
VILLOW_AGENT_ID=
VILLOW_KEY_ID=
VILLOW_SECRET=
